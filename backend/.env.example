# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# Qwen (Tongyi Qianwen)
QWEN_API_KEY=sk-your-qwen-api-key-here
QWEN_MODEL=qwen-plus

# Kimi (Moonshot)
KIMI_API_KEY=sk-your-kimi-api-key-here
KIMI_MODEL=moonshot-v1-8k

# Default LLM provider — one of: openai | deepseek | qwen | kimi
DEFAULT_LLM_PROVIDER=openai

# QWeather auth: PEM Ed25519 private key, signed JWT, or API key.
WEATHER_API_KEY=your-qweather-private-key-or-jwt-or-api-key-here
WEATHER_PROVIDER=qweather
# This is the developer-specific API Host shown in the QWeather console.
QWEATHER_BASE_URL=https://your-api-host.re.qweatherapi.com
# auto | jwt | api_key. Defaults to auto.
QWEATHER_AUTH_MODE=auto
# Required when WEATHER_API_KEY contains an Ed25519 private key.
QWEATHER_CREDENTIAL_ID=your-qweather-credential-id-here
QWEATHER_PROJECT_ID=your-qweather-project-id-here
# Optional private-key source. Use either the key itself or a file path.
QWEATHER_PRIVATE_KEY=
QWEATHER_PRIVATE_KEY_PATH=
QWEATHER_JWT_TTL_SECONDS=900

# Maps API (高德 / Google Maps)
MAPS_API_KEY=your-maps-api-key-here
MAPS_PROVIDER=amap
