# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# Qwen (Tongyi Qianwen)
QWEN_API_KEY=sk-your-qwen-api-key-here
QWEN_MODEL=qwen-plus

# Kimi (Moonshot)
KIMI_API_KEY=sk-your-kimi-api-key-here
KIMI_MODEL=moonshot-v1-8k

# Default LLM provider — one of: openai | deepseek | qwen | kimi
DEFAULT_LLM_PROVIDER=openai

# QWeather auth: PEM Ed25519 private key, signed JWT, or API key.
WEATHER_API_KEY=your-qweather-private-key-or-jwt-or-api-key-here
WEATHER_PROVIDER=qweather
# This is the developer-specific API Host shown in the QWeather console.
QWEATHER_BASE_URL=https://your-api-host.re.qweatherapi.com
# auto | jwt | api_key. Defaults to auto.
QWEATHER_AUTH_MODE=auto
# Required when WEATHER_API_KEY contains an Ed25519 private key.
QWEATHER_CREDENTIAL_ID=your-qweather-credential-id-here
QWEATHER_PROJECT_ID=your-qweather-project-id-here
# Optional private-key source. Use either the key itself or a file path.
QWEATHER_PRIVATE_KEY=
QWEATHER_PRIVATE_KEY_PATH=
QWEATHER_JWT_TTL_SECONDS=900

# Maps API (高德 / Google Maps)
MAPS_API_KEY=your-maps-api-key-here
MAPS_PROVIDER=amap

# PostgreSQL (P0.1 行程持久化)
# Docker Compose 部署时由 environment 自动注入；本地开发用此默认值
PG_DSN=postgresql://coupletrip:coupletrip_dev@localhost:5432/coupletrip

# 对话会话与聊天记录同样存 PostgreSQL（V3/P1 起）——不再需要 Redis。
# 多 worker 部署时才需要 broker（SSE 事件扇出 + 共享限流计数），详见 DEPLOY.md。

# P3.1 鉴权与限流
# AUTH_ENABLED=false（默认）时跳过 X-API-Key 校验，开发/测试零回归；
# 生产环境设 true，客户端须在 X-API-Key 头携带下方白名单内的 key。
AUTH_ENABLED=false
# 逗号分隔的合法 key 列表，例：ct-dev-key-1234,ct-prod-key-5678
API_KEYS=
# RATE_LIMIT_ENABLED=false（默认）时限流中间件挂载但不计数；
# 生产环境设 true 开启（/api/plan 10/min/IP、/api/chat 30/min/IP）。
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PLAN=10/minute
RATE_LIMIT_CHAT=30/minute

# P3.2 可观测性
# JSON_LOGS=true（默认）输出结构化 JSON 日志；false 用 console 彩色渲染（开发调试）
JSON_LOGS=true

# P3.3 CORS：逗号分隔的允许来源，例：http://localhost:5173,https://coupletrip.example.com
CORS_ORIGINS=http://localhost:5173
